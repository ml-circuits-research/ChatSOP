(set-option :timeout 3000)
(set-logic QF_LIA)
(declare-const arrival Int)
(assert (>= arrival 770))
(assert (<= arrival 900))
(assert (>= arrival (+ 770 70)))
; claim is tested separately, not assumed true
(push)
(assert (<= arrival 840))
(check-sat)
(pop)
(push)
(assert (not (<= arrival 840)))
(check-sat)
(pop)
