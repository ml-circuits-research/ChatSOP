{
  "_note": "TinyAgent built-in defaults (the first configuration layer). Layers: this file, then the user's ~/.tinyagent/config.json, then a project configuration (--config, TINYAGENT_CONFIG, or the nearest config/tinyagent.json or tinyagent.config.json). Objects merge key by key, arrays and tier chains are replaced, null removes a key. Relative paths resolve against the folder of the layer that names them. Keys are never written here: ~/.tinyagent/keys/<provider>.env (the key folder of earlier versions is read as a fallback). With no key configured only the local models serve: nano, micro and tiny, and tiny also serves small, medium, good and best.",
  "server": {
    "host": "127.0.0.1",
    "port": 18080
  },
  "dataDir": "~/.tinyagent/data",
  "cacheDir": "~/.tinyagent/cache",
  "auditDir": "~/.tinyagent/audit",
  "logDir": "~/.tinyagent/logs",
  "promptsDir": "prompts",
  "defaultUpstream": "openference",
  "injectStreamUsage": true,
  "modelsCacheSeconds": 600,
  "providers": {
    "openference": {
      "baseUrl": "https://api.openference.com",
      "envFile": "openference.env",
      "keyVar": "OPENFERENCE_API_KEY",
      "baseUrlVar": "OPENFERENCE_BASE_URL",
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions",
        "anthropic": "/v1/messages"
      },
      "limits": {
        "maxConcurrent": 4,
        "maxPerSecond": 5,
        "maxPerMinute": 15,
        "maxPerHour": 800
      },
      "retry": {
        "max": 4,
        "baseMs": 1000,
        "maxWaitMs": 60000,
        "max5xx": 2
      },
      "plan": {
        "priceUsdPerMonth": 15,
        "_note": "15 requests per minute; about 400 plan credits per 5 hours and 7,500 per week; a call costs its model's quota_multiplier (x-quota-cost).",
        "limits": [
          {
            "name": "per_minute",
            "unit": "calls",
            "window": "60s",
            "max": 15,
            "provider": {
              "remainingHeader": "x-ratelimit-remaining",
              "resetHeader": "x-ratelimit-reset"
            }
          },
          {
            "name": "per_5h",
            "unit": "credits",
            "window": "5h",
            "max": 400,
            "provider": {
              "remainingHeader": "x-quota-remaining",
              "costHeader": "x-quota-cost"
            }
          },
          {
            "name": "per_week",
            "unit": "credits",
            "window": "7d",
            "max": 7500
          }
        ]
      }
    },
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api",
      "envFile": "openrouter.env",
      "keyVar": "OPENROUTER_API_KEY",
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxConcurrent": 8,
        "maxPerSecond": 5,
        "maxPerMinute": 120,
        "maxPerHour": 3000
      },
      "retry": {
        "max": 4,
        "baseMs": 1000,
        "maxWaitMs": 60000
      }
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com",
      "envFile": "deepseek.env",
      "keyVar": "DEEPSEEK_API_KEY",
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxConcurrent": 8,
        "maxPerSecond": 5,
        "maxPerMinute": 120,
        "maxPerHour": 3000
      },
      "retry": {
        "max": 4,
        "baseMs": 1000,
        "maxWaitMs": 60000
      }
    },
    "local": {
      "_note": "tiny: Qwen3.6-35B-A3B (MoE, about 3B active), always on, 8 slots of 16k tokens.",
      "baseUrl": "http://127.0.0.1:19611",
      "noKey": true,
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxPerSecond": 50,
        "maxPerMinute": 3000,
        "maxPerHour": 100000
      },
      "retry": {
        "max": 0,
        "max5xx": 0,
        "baseMs": 500,
        "maxWaitMs": 5000
      },
      "start": {
        "bin": "llama-server",
        "gguf": "~/.tinyagent/models/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf",
        "alias": "Qwen3.6-35B-A3B",
        "slots": 8,
        "ctxPerSlot": 16384,
        "args": [
          "-ngl",
          "99",
          "-fa",
          "on",
          "--jinja",
          "--no-webui"
        ],
        "requireFreeGpu": false,
        "startTimeoutMs": 300000,
        "idleStopMs": 0,
        "startAtBoot": true
      }
    },
    "localsuper": {
      "_note": "micro (formerly supertiny): Qwen3-4B-Instruct-2507, on demand, stopped after 15 idle minutes, 32 slots.",
      "baseUrl": "http://127.0.0.1:19613",
      "noKey": true,
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxPerSecond": 200,
        "maxPerMinute": 6000,
        "maxPerHour": 200000
      },
      "retry": {
        "max": 0,
        "max5xx": 0,
        "baseMs": 500,
        "maxWaitMs": 5000
      },
      "start": {
        "bin": "llama-server",
        "gguf": "~/.tinyagent/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf",
        "alias": "Qwen3-4B",
        "slots": 32,
        "ctxPerSlot": 4096,
        "args": [
          "-ngl",
          "99",
          "-fa",
          "on",
          "--jinja",
          "--no-webui",
          "--cache-reuse",
          "256"
        ],
        "requireFreeGpu": false,
        "startTimeoutMs": 120000,
        "idleStopMs": 900000,
        "startAtBoot": false
      }
    },
    "localnano": {
      "_note": "nano: Qwen3-0.6B (Q8_0), on demand, stopped after 15 idle minutes, 32 slots; the smallest and fastest local model.",
      "baseUrl": "http://127.0.0.1:19614",
      "noKey": true,
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxPerSecond": 200,
        "maxPerMinute": 6000,
        "maxPerHour": 200000
      },
      "retry": {
        "max": 0,
        "max5xx": 0,
        "baseMs": 500,
        "maxWaitMs": 5000
      },
      "start": {
        "bin": "llama-server",
        "gguf": "~/.tinyagent/models/Qwen3-0.6B-Q8_0.gguf",
        "alias": "Qwen3-0.6B",
        "slots": 32,
        "ctxPerSlot": 4096,
        "args": [
          "-ngl",
          "99",
          "-fa",
          "on",
          "--jinja",
          "--no-webui",
          "--cache-reuse",
          "256"
        ],
        "requireFreeGpu": false,
        "startTimeoutMs": 120000,
        "idleStopMs": 900000,
        "startAtBoot": false
      }
    }
  },
  "tiers": {
    "_note": "Clients name a tier, never a model. A tier is a chain of {upstream, model}; the first entry whose provider has a key (or needs none) serves, the rest is its fallback. With no key configured the cloud entries are skipped and the local tiny serves the higher tiers.",
    "maxWaitMs": 120000,
    "nano": [
      {
        "upstream": "localnano",
        "model": "Qwen3-0.6B"
      }
    ],
    "micro": [
      {
        "upstream": "localsuper",
        "model": "Qwen3-4B"
      },
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "supertiny": "micro",
    "tiny": [
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      },
      {
        "upstream": "openference",
        "model": "DeepSeek-V4-Flash-0731"
      },
      {
        "upstream": "openrouter",
        "model": "deepseek/deepseek-v4-flash"
      }
    ],
    "small": [
      {
        "upstream": "openference",
        "model": "Qwen3.8 27b"
      },
      {
        "upstream": "openference",
        "model": "DeepSeek-V4-Flash-0731"
      },
      {
        "upstream": "openrouter",
        "model": "deepseek/deepseek-v4-flash"
      },
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "medium": [
      {
        "upstream": "openference",
        "model": "DeepSeek-V4-Flash-0731"
      },
      {
        "upstream": "openrouter",
        "model": "deepseek/deepseek-v4-flash"
      },
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "good": [
      {
        "upstream": "openference",
        "model": "DeepSeek-V4-Flash-0731",
        "timeoutMs": 290000
      },
      {
        "upstream": "openrouter",
        "model": "deepseek/deepseek-v4.1-flash"
      },
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "best": [
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ]
  },
  "fallback": {
    "from": "openference",
    "upstream": "openrouter",
    "models": {
      "Qwen3.8 27b": "deepseek/deepseek-v4-flash"
    },
    "maxWaitMs": 120000
  },
  "audit": {
    "enabled": true,
    "tiers": [
      "tiny",
      "small",
      "medium"
    ],
    "upstreams": [
      "local"
    ],
    "maxBytesPerDay": 209715200,
    "maxDays": 14,
    "maxCharsPerField": 200000
  },
  "policy": {
    "allowedPurposes": [
      "chat",
      "formalize",
      "answer-*",
      "ingest",
      "job:*",
      "review:*",
      "skill:*",
      "run:*",
      "test:*"
    ],
    "untaggedDailyMax": 100,
    "keepDays": 7
  },
  "interactive": {
    "purposes": [
      "chat",
      "formalize",
      "answer-*"
    ],
    "maxWaitMs": 15000
  },
  "cache": {
    "defaultMode": "use"
  },
  "runner": {
    "_note": "The job runner (jobs, tasks, skills, run): run folders, the template library a task planner chooses from, roles (role -> tier), limits of planned tasks.",
    "dataDir": "~/.tinyagent/runs",
    "templatesDir": null,
    "roles": {
      "planner": "good",
      "decider": "good",
      "auditor": "medium",
      "worker": "small",
      "worker-short": "tiny"
    },
    "limits": {
      "maxTaskUsd": 2,
      "maxTaskCredits": 100,
      "maxTaskCalls": 2000
    },
    "tasks": {
      "keepDays": 7
    }
  },
  "skills": {
    "plugins": [],
    "jobs": {}
  },
  "run": {
    "budget": {
      "usd": 0.5,
      "credits": 60,
      "calls": 300
    },
    "maxSteps": 5
  },
  "sandbox": {
    "timeMs": 120000,
    "heapMb": 128,
    "maxCalls": 50,
    "maxCodeBytes": 20000,
    "maxOutputBytes": 1000000,
    "tiers": [
      "nano",
      "micro",
      "tiny",
      "small",
      "medium"
    ]
  },
  "background": {
    "share": 0.7,
    "purposes": [],
    "_note": "Background work (x-tinyagent-priority: background, a job's priority, or these purposes) runs when nothing else waits, within `share` of every rate and plan window; held, never refused."
  }
}
