# Shared verification world of the generated corpora: converse-equivalence rules. Evaluation-only; never model input.
# Rows reference blocks by id (row.world); lib/row-world.mjs assembles a row's world. Generated by tools/datasets/build-corpora.mjs.

# block works_at
@conv_works_at_1 rule
  when works_at ?a ?b
  then works_at__converse ?b ?a

@conv_works_at_2 rule
  when works_at__converse ?b ?a
  then works_at ?a ?b

@conv_works_at_3 rule
  when not works_at ?a ?b
  then not works_at__converse ?b ?a

@conv_works_at_4 rule
  when not works_at__converse ?b ?a
  then not works_at ?a ?b

