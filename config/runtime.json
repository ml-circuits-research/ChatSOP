{
  "root": "state",
  "memory": {
    "engine": "sqlite",
    "power": 12,
    "arity": 3,
    "verification": "receipt",
    "journal": false,
    "retention": {
      "mode": "none",
      "safeOccupancy": 0.55,
      "targetOccupancy": 0.42,
      "writeStrength": 2,
      "useStrength": 1,
      "decayStep": 1,
      "maxSweeps": 6,
      "reinforceOnUse": true,
      "pruneMetadata": true
    },
    "sharding": {
      "enabled": true,
      "mode": "bounded",
      "safeOccupancy": 0.55,
      "maxClaimsPerShard": 1024,
      "maxShardMetadataBytes": 2097152,
      "maxColdShards": 8,
      "maxHotAgeMs": null,
      "maxColdAgeMs": null,
      "maxNormalBankBytes": null,
      "maxPinnedBankBytes": null,
      "maxArchiveShards": null,
      "gcEveryWrites": 32
    }
  },
  "policy": {
    "allowWrite": true,
    "allowPin": true,
    "allowRules": false,
    "modelAssumptions": "report",
    "maxWires": 2048,
    "maxEpochs": 16,
    "maxProbes": 50000,
    "maxFacts": 10000,
    "maxJoins": 30000,
    "maxAssignments": 100000,
    "retrievalStrategy": "hybrid",
    "maxGoals": 256,
    "maxRules": 1024,
    "maxShards": 256
  },
  "assistant": "chatsop",
  "chatData": {
    "root": "chat_data",
    "defaultBase": "world-v1",
    "tmpTtlHours": 24,
    "sessionTtlDays": 14,
    "cleanupIntervalMinutes": 60
  },
  "conversation": {
    "_note": "The chat's reply memory (DS022 \"Composing a base memory\", DS023 \"Conversation layer\"): composed from these layers when it is missing; rebuild it with other layers on /admin (base-memory composer).",
    "memory": "conversation-default",
    "name": "Conversation (default set)",
    "layers": ["conversation-v1", "smalltalk-core-v1", "smalltalk-empathy-v1", "smalltalk-self-v1", "smalltalk-playful-v1"]
  },
  "answerLanguage": {
    "providers": [
      "small"
    ],
    "natural": "all"
  },
  "llmProviders": {
    "openference": {
      "baseUrl": "http://127.0.0.1:18080/v1",
      "model": "Qwen3.8 27b",
      "requestsPerMinute": 15,
      "timeoutSeconds": 120,
      "maxTokens": 4000,
      "thinking": false,
      "proxyFallback": false
    },
    "openrouter": {
      "baseUrl": "http://127.0.0.1:18080/u/openrouter/v1",
      "model": "deepseek/deepseek-v4-flash",
      "timeoutSeconds": 120,
      "maxTokens": 4000,
      "thinking": false,
      "proxyFallback": false
    },
    "local": {
      "baseUrl": "http://127.0.0.1:18080/u/local/v1",
      "model": "Qwen3-4B",
      "timeoutSeconds": 120,
      "maxTokens": 1500,
      "thinking": false,
      "proxyFallback": false
    }
  },
  "ingest": {
    "author": "direct",
    "tier": "small",
    "reasoning": "off",
    "concurrency": 3
  },
  "queryParser": {
    "strategy": "LLMDirect",
    "models": [
      "small"
    ],
    "timeoutSeconds": 120,
    "maxFixRounds": 2,
    "selfCheck": false,
    "maxConcurrent": 4,
    "cacheEntries": 500,
    "local": {
      "tier": "tiny",
      "maxTokens": 1500,
      "thinking": false,
      "method": "B"
    }
  },
  "server": {
    "warmup": true,
    "warmMemories": [
      "world-v1"
    ]
  }
}
