{
  "root": "state",
  "memory": {
    "engine": "sqlite",
    "power": 12,
    "arity": 3,
    "verification": "receipt",
    "journal": false,
    "retention": {
      "mode": "none",
      "safeOccupancy": 0.55,
      "targetOccupancy": 0.42,
      "writeStrength": 2,
      "useStrength": 1,
      "decayStep": 1,
      "maxSweeps": 6,
      "reinforceOnUse": true,
      "pruneMetadata": true
    },
    "sharding": {
      "enabled": true,
      "mode": "bounded",
      "safeOccupancy": 0.55,
      "maxClaimsPerShard": 1024,
      "maxShardMetadataBytes": 2097152,
      "maxColdShards": 8,
      "maxHotAgeMs": null,
      "maxColdAgeMs": null,
      "maxNormalBankBytes": null,
      "maxPinnedBankBytes": null,
      "maxArchiveShards": null,
      "gcEveryWrites": 32
    }
  },
  "policy": {
    "allowWrite": true,
    "allowPin": true,
    "allowRules": false,
    "modelAssumptions": "report",
    "maxWires": 2048,
    "maxEpochs": 16,
    "maxProbes": 50000,
    "maxFacts": 10000,
    "maxJoins": 30000,
    "maxAssignments": 100000,
    "retrievalStrategy": "hybrid",
    "maxGoals": 256,
    "maxRules": 1024,
    "maxShards": 256
  },
  "chatData": {
    "root": "chat_data",
    "defaultBase": "world-v1",
    "tmpTtlHours": 24,
    "sessionTtlDays": 14,
    "cleanupIntervalMinutes": 60
  },
  "omp": {
    "enabled": true,
    "bin": "omp",
    "timeoutSeconds": 600,
    "maxFixRounds": 3,
    "maxConcurrent": 2,
    "modelsCacheSeconds": 600,
    "defaultModel": null
  },
  "queryParser": {
    "backend": {
      "kind": "omp",
      "model": "zai/glm-5.3",
      "thinking": "off"
    },
    "models": [
      "zai/glm-5.3",
      "openai-codex/gpt-6-luna"
    ],
    "timeoutSeconds": 120,
    "maxFixRounds": 2,
    "selfCheck": false,
    "maxConcurrent": 4,
    "cacheEntries": 500,
    "keepFolders": false
  },
  "server": {
    "warmup": true,
    "warmMemories": [
      "world-v1"
    ]
  }
}
