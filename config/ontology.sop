# Control-plane vocabulary. Alias is not subsumption; mother is not normalized away.
# `role NAME TYPE` maps each argument position, in order, to the closed role inventory
# (subject, object, recipient, location, source, destination, instrument, time, topic; DS021).
# The host links model propositions such as relation "works at" + role subject/object to these predicates.
@parent predicate
  role subject person
  role object person
  description "relație de părinte, fără presupunere despre gen"
  label ro "părinte"
  alias ro "este părintele"
  alias ro "părintele"
  alias en "parent"
  alias en "parent of"
  alias de "Elternteil"

@mother predicate
  role subject person
  role object person
  description "relație explicită de mamă"
  label ro "mamă"
  alias ro "mama"
  alias ro "este mama"
  alias en "mother"

@father predicate
  role subject person
  role object person
  description "relație explicită de tată"
  label ro "tată"
  alias ro "tatăl"
  alias en "father"

@grandparent predicate
  role subject person
  role object person
  description "părintele unui părinte; fără gen dedus din nume"
  label ro "bunic sau bunică"
  alias en "grandparent"

@grandmother predicate
  role subject person
  role object person
  description "bunică, derivată numai cu informație despre relația maternală"
  label ro "bunică"
  alias ro "bunica"
  alias en "grandmother"

@ancestor predicate
  role subject person
  role object person
  description "relație de ascendență prin părinți"
  label ro "strămoș"
  alias en "ancestor"

@works_at predicate
  role subject person
  role object organization
  description "lucrează la organizație; nu afirmă automat statut de angajat sau locație fizică"
  label ro "lucrează la"
  alias ro "muncește la"
  alias en "works at"
  alias de "arbeitet bei"
  alias fr "travaille chez"
  alias it "lavora presso"

@employed_by predicate
  role subject person
  role object organization
  description "raport explicit de angajare"
  label ro "este angajat la"
  alias ro "este angajată la"
  alias en "employed by"

@contractor_for predicate
  role subject person
  role object organization
  description "prestator sau contractor, nu neapărat angajat"
  label ro "este contractor pentru"
  alias en "contractor for"

@located_in predicate
  role subject entity
  role location place
  description "localizare explicit afirmată; nu se deduce din locul de muncă"
  label ro "se află în"
  alias ro "este localizat în"
  alias en "located in"

@project_member predicate
  role subject person
  role object project
  description "participare la proiect"
  label ro "participă la"
  alias en "member of project"

@duration predicate
  role subject entity
  role object integer
  description "durată numerică; unitatea este stabilită de schema aplicației, aici minute"
  label ro "durează"
  alias en "takes minutes"

@costs predicate
  role subject entity
  role object integer
  description "preț numeric în lei; valori de atribut pentru compare și rank (DS021 Q-LANG-1)"
  label ro "costă"
  alias en "cost"

@age predicate
  role subject person
  role object integer
  description "vârsta în ani; valoare de atribut pentru compare și rank (DS021 Q-LANG-1)"
  label ro "are vârsta"
  alias en "be aged"
  alias en "be old"

@likes predicate
  role subject person
  role object entity
  description "preferință explicită"
  label ro "preferă"
  alias en "likes"

