  when budget_left
  then askable ask_places_again ?i

@askable_ask_places_again_v_not_placed rule
  when violation v_not_placed ?qq
  when number_instance ?qq ?i
  when absent reasked ?i
  when budget_left
  then askable ask_places_again ?i

@askable_ask_places_again_validator rule
  when repair_target ?qq ?i
  when assembly_failed
  when repairs_left
  when absent reasked ?i
  when budget_left
  then askable ask_places_again ?i

@ask_places_again action
  params ?a
  requires askable ask_places_again ?a
  adds answered ask_places_again ?a
  adds reasked ?a
  cost 2

# The goal of every decision.
@formalized_goal goal
  where formalized
