  requires askable assemble ?a
  adds answered assemble ?a
  cost 0

@askable_ask_places_again_asked_not_placed rule
  when violation asked_not_placed ?qq
  when main_instance ?qq ?i
  when absent reasked ?i
  when budget_left
  then askable ask_places_again ?i

@askable_ask_places_again_name_in_number_place rule
  when violation name_in_number_place ?i
  when absent reasked ?i
  when budget_left
  then askable ask_places_again ?i

