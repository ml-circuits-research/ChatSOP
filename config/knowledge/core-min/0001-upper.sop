# core-min: the smallest shared vocabulary every base memory imports (linking proposal M1). It declares the relation `is_a`
# and the upper classes; the English core of the next milestone (`core-en`) extends it and never redeclares these ids.
# A class is an entity of kind class; class membership is an `is_a` fact or the `kind` line of an entity.

@is_a predicate
  args subject:entity object:entity
  label en "is a"
  description "the subject belongs to the class named by the object; between two classes it is subclass of"
  reading class
  reading describe
  describe_rank 1
  transitive true

@lx_is_a_en lexeme
  of is_a
  language en
  pos copula
  form "be a"
  form "be an"
  form "be a kind of"
  frame subject object
  source "core-min: the copula reading of is_a (DS021 The copula)"

@class entity
  kind class
  label en "class"
  alias en "category"
  alias en "type"
  label ro "clasă"

@entity entity
  kind class
  label en "entity"
  alias en "thing"
  label ro "entitate"

@person entity
  kind class
  label en "person"
  alias en "human"
  alias en "individual"
  label ro "persoană"

@organization entity
  kind class
  label en "organization"
  alias en "organisation"
  alias en "institution"
  label ro "organizație"

@place entity
  kind class
  label en "place"
  alias en "location"
  label ro "loc"

@occupation entity
  kind class
  label en "occupation"
  alias en "profession"
  alias en "job"
  label ro "ocupație"

@property entity
  kind class
  label en "property"
  alias en "attribute"
  alias en "quality"
  label ro "proprietate"

@unit entity
  kind class
  label en "unit"
  alias en "unit of measure"
  label ro "unitate de măsură"
