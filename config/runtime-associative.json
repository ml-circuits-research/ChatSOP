{
  "root": "state",
  "ontology": "config/ontology.sop",
  "memory": {
    "power": 12,
    "arity": 3,
    "verification": "receipt",
    "journal": false,
    "exact": false,
    "retention": {
      "mode": "adaptive",
      "safeOccupancy": 0.55,
      "targetOccupancy": 0.42,
      "writeStrength": 2,
      "useStrength": 1,
      "decayStep": 1,
      "maxSweeps": 6,
      "reinforceOnUse": true,
      "pruneMetadata": true
    }
  },
  "formalizer": {
    "url": "http://127.0.0.1:8080/v1/chat/completions",
    "model": "formalizer",
    "maxTokens": 1024,
    "timeoutMs": 120000
  },
  "verbalizer": {
    "url": "http://127.0.0.1:8080/v1/chat/completions",
    "model": "verbalizer",
    "maxTokens": 384,
    "timeoutMs": 120000
  },
  "policy": {
    "allowWrite": true,
    "allowPin": true,
    "allowRules": false,
    "maxWires": 2048,
    "maxEpochs": 16,
    "maxProbes": 50000,
    "maxFacts": 10000,
    "maxJoins": 30000,
    "maxAssignments": 100000,
    "retrievalStrategy": "recall-memory",
    "maxGoals": 256,
    "maxRules": 1024
  }
}
